# Copy to .env and enter your key privately. Never put real keys in this template.
GEMINI_API_KEY=
# Optional: exact available model ID. If blank, discover an advertised Flash model.
GEMINI_MODEL=
SARVAM_API_KEY=
# Local combined store; this key must match store-api/.env.
STORE_API_URL=http://127.0.0.1:8001
STORE_API_KEY=local-demo-key
